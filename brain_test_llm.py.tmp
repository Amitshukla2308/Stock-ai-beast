import os
import requests
import json
import time
from dotenv import load_dotenv

load_dotenv()

# Configuration
API_BASE = os.getenv("VLLM_API_BASE", "http://localhost:8000/v1")
API_KEY = os.getenv("VLLM_API_KEY", "EMPTY")
MODEL_NAME = os.getenv("MODEL_NAME", "Qwen/Qwen2.5-32B-Instruct-AWQ") 

def test_connection():
    print(f"📡 Testing Connection to {API_BASE}...")
    try:
        # Check models endpoint
        resp = requests.get(f"{API_BASE}/models")
        if resp.status_code == 200:
            models = resp.json()
            print(f"✅ Server is UP! Found models: {[m['id'] for m in models['data']]}")
            return True
        else:
            print(f"❌ Server reachable but returned {resp.status_code}")
            return False
    except requests.exceptions.ConnectionError:
        print("❌ Could not connect. Is the Docker container running and fully loaded?")
        return False

def test_inference():
    print(f"\n🧠 Testing Inference (JSON Mode) on {MODEL_NAME}...")
    
    prompt = "Analyze the trend: Price is above 200 EMA, RSI is 60."
    
    payload = {
        "model": MODEL_NAME,
        "messages": [
            {"role": "system", "content": "You are a trading bot. return valid json with keys: sentiment, confidence."},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.1,
        "max_tokens": 100
    }
    
    start_time = time.time()
    try:
        resp = requests.post(
            f"{API_BASE}/chat/completions",
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {API_KEY}"},
            json=payload
        )
        latency = (time.time() - start_time) * 1000
        
        if resp.status_code == 200:
            result = resp.json()
            content = result['choices'][0]['message']['content']
            print(f"✅ Response ({latency:.2f}ms):\n{content}")
            
            # JSON Check
            try:
                json.loads(content)
                print("✅ Valid JSON")
            except:
                print("⚠️ Invalid JSON output")
        else:
             print(f"❌ Error {resp.status_code}: {resp.text}")

    except Exception as e:
        print(f"❌ Exception: {e}")

if __name__ == "__main__":
    if test_connection():
        test_inference()
