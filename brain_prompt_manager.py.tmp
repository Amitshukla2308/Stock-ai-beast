import json

def construct_prompt(technical_state: dict, news_summary: str = "") -> str:
    """
    Constructs the prompt for the CXO LLM.
    Cold Path Logic: Digest the Hot Path data into a semantic payload.
    """
    
    prompt = f"""
    You are the Chief Investment Officer (CXO) of an automated trading fund.
    Your workers have provided the following data.
    
    MARKET STATE:
    - Current Price: {technical_state.get('current_price', 'N/A')}
    - Trend: {technical_state.get('trend', 'UNKNOWN')}
    - RSI: {technical_state.get('rsi', 50):.2f}
    - Volatility: {technical_state.get('volatility', 0):.2f}%
    
    TECHNICAL SIGNALS:
    - Fast MA: {technical_state.get('ma_fast', 0):.2f}
    - Slow MA: {technical_state.get('ma_slow', 0):.2f}
    
    GLOBAL CONTEXT:
    {news_summary if news_summary else "No major news updates."}
    
    INSTRUCTIONS:
    Decide on the next action. You must be conservative.
    Return a strictly valid JSON object with:
    - "action": "BUY", "SELL", or "HOLD"
    - "confidence": Float between 0.0 and 1.0 (How sure are you?)
    - "reasoning": A short sentence explaining why.
    - "target_pct": Your recommended profit target percentage (e.g., 0.01 for 1%).
    - "stop_loss_pct": Your recommended stop loss percentage.
    """
    return prompt
